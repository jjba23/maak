;;; Commentary:
;;
;; A project can ship its automation: one artefact that runs the Maak file on a
;; machine with neither Guile nor maak installed.  The artefact is a `guix pack'
;; of a generated package, so it is built by the Guix helpers this repository
;; already has rather than by a second packaging system.
;;
;; The generated package is deliberately small.  It installs the Maak file and
;; a launcher, and it propagates maak, Guile and whatever the project asks for;
;; `guix pack -S /bin=bin' then puts the launcher, maak, Guile and those tools
;; on the pack's `/bin'.  The launcher puts its own directory first on PATH, so
;; a task inside the bundle finds the maak and the Guile the bundle came with.
;;
;; A package rather than a script that copies files: the closure is what makes
;; the artefact self-contained, and it is Guix that knows how to compute it.

;;; Code:

(define-module (maak bundle)
  #:declarative? #t
  #:use-module (ice-9 format)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-13)
  #:use-module (maak dsl)
  #:use-module (maak shell)
  #:use-module (maak container)
  #:export (bundle-script bundle bundle-file-name))

;; Files are named from this counter, so two bundles in one process never share
;; a generated package file.
(define bundle-counter 0)

(define valid-name-characters
  (string->list "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._"))

(define (valid-name? value)
  "Return #t when VALUE is a name a file and a store path can carry."
  (and (string? value)
       (not (string=? value ""))
       (not (string=? value "."))
       (not (string=? value ".."))
       (string-every (lambda (char) (memv char valid-name-characters)) value)))

(define (require-name value what)
  "Return VALUE when it names something a bundle can carry, else raise."
  (unless (valid-name? value)
    (raise-maak-error
     (format #f "~a must be one path component of letters, digits, '-', '.' or '_', got ~s"
             what value)
     #:hint "Name the bundle \"maak\" or \"project-automation\", not a path."))
  value)

(define (require-package-names packages)
  "Return PACKAGES after checking every entry is a package name string."
  (unless (list? packages)
    (raise-maak-error
     (format #f "#:packages takes a list of Guix package names, got ~s" packages)
     #:hint "Write #:packages '(\"bash\" \"coreutils\")."))
  (for-each (lambda (package)
              (unless (and (string? package) (not (string=? package "")))
                (raise-maak-error
                 (format #f "#:packages entries must be package name strings, got ~s"
                         package)
                 #:hint "Write #:packages '(\"bash\" \"coreutils\").")))
            packages)
  packages)

(define* (bundle-script #:key
                        (name "automation")
                        (maak-file "maak.scm")
                        (maak-package "(specification->package \"maak\")")
                        (packages '("bash" "coreutils"))
                        (home-page "https://github.com/jjba23/maak")
                        (description #f))
  "Return the Guix package file that defines a bundle for NAME.

MAK-FILE is the Maak file to ship; MAK-PACKAGE is a Scheme expression that
evaluates to the maak package, and PACKAGES are the extra package names the
automation needs.  The expression is inserted as written, so it is trusted
input: it is how a project points at its own build of maak.

The package installs the Maak file under `share/NAME' and a launcher in
`bin/NAME', and propagates maak, Guile and the packages, so `guix pack -S
/bin=bin' gives a pack whose `bin' holds all of them."
  (require-name name "the bundle name")
  (require-package-names packages)
  (unless (and (string? maak-package) (not (string=? maak-package "")))
    (raise-maak-error
     (format #f "#:maak-package takes the Scheme expression for the maak package, got ~s"
             maak-package)
     #:hint "The default is (specification->package \"maak\")."))
  (unless (and (string? maak-file) (file-exists? maak-file))
    (raise-maak-error
     (format #f "no Maak file at ~a to bundle" maak-file)
     #:hint "Name the file with #:maak-file, from the directory the bundle is built in."))
  (let ((absolute (canonicalize-path maak-file))
        (summary (or description
                     (format #f "The automation of this project, shipped as a self-contained maak bundle."))))
    (string-join
     (list
      ";; Generated by `maak bundle'; edit the Maak file, not this."
      "(use-modules (gnu packages)"
      "             (gnu packages bash)"
      "             (gnu packages guile)"
      "             (guix build-system trivial)"
      "             (guix gexp)"
      "             (guix licenses)"
      "             (guix packages))"
      ""
      (format #f "(define maak ~a)" maak-package)
      ""
      "(package"
      (format #f "  (name ~s)" name)
      "  (version \"0\")"
      "  (source #f)"
      "  (build-system trivial-build-system)"
      "  (arguments"
      "   (list #:builder"
      "         #~(begin"
      "             (use-modules (guix build utils))"
      "             (let ((out (assoc-ref %outputs \"out\"))"
      (format #f "                   (maak-file #$(local-file ~s \"maak.scm\")))" absolute)
      "               (mkdir-p (string-append out \"/bin\"))"
      (string-append "               (mkdir-p (string-append out \"/share/" name "\"))")
      (string-append "               (copy-file maak-file (string-append out \"/share/"
                     name "/maak.scm\"))")
      (string-append "               (let ((launcher (string-append out \"/bin/" name "\")))")
      "                 (call-with-output-file launcher"
      "                   (lambda (port)"
      (string-append
       "                     (format port \"#!~a\\nPATH=\\\"$(dirname \\\"$0\\\"):$PATH\\\"\\nexport PATH\\nexec ~a -f ~a/share/"
       name
       "/maak.scm \\\"$@\\\"\\n\"")
      "                             #$(file-append bash \"/bin/bash\")"
      "                             #$(file-append maak \"/bin/maak\")"
      "                             out)))"
      "                 (chmod launcher #o755)))))"
      "  (propagated-inputs"
      (format #f "   (append (list maak guile bash) (map specification->package '~s)))"
              packages)
      (format #f "  (synopsis ~s)" (format #f "~a as a self-contained maak bundle" name))
      (format #f "  (description ~s)" summary)
      (format #f "  (home-page ~s)" home-page)
      "  (license license:expat))")
     "\n")))

(define (bundle-extension format)
  "Return the file extension a pack of FORMAT is usually written with."
  (cond
    ((string=? format "squashfs") ".squashfs")
    ((string=? format "docker") "-docker.tar.gz")
    (else ".tar.gz")))

(define (bundle-file-name name pack-format)
  "Return the file name a bundle of NAME in PACK-FORMAT is written to."
  (format #f "~a-bundle~a" name (bundle-extension pack-format)))

(define (bundle-script-path)
  "Return a file name of this run's own for the generated package."
  (set! bundle-counter (+ bundle-counter 1))
  (format #f "~a/maak-bundle-~a-~a.scm"
          (tmp-dir) (getpid) bundle-counter))

(define* (bundle #:key
                 (name "automation")
                 (format "tarball")
                 (output #f)
                 (maak-file "maak.scm")
                 (maak-package "(specification->package \"maak\")")
                 (packages '("bash" "coreutils"))
                 (home-page "https://github.com/jjba23/maak")
                 (description #f)
                 (load? #f)
                 (verbose? #f))
  "Build a self-contained bundle of NAME's automation and return its path.

The bundle is a Guix pack of a generated package that installs MAK-FILE and a
launcher, and carries maak, Guile and PACKAGES with it, so it runs on a
machine with none of them.  FORMAT is a `guix pack' format: \"tarball\" (made
relocatable, so it extracts anywhere), \"squashfs\" or \"docker\".  OUTPUT names
the file; by default it is NAME-bundle with an extension for FORMAT.

With LOAD? a docker pack is loaded into the container engine afterwards, using
the `(maak container)' helper, so the image is ready to run as well as written.

@example
(bundle #:name \"site\" #:maak-file \"maak.scm\"
        #:packages '(\"git\" \"curl\") #:format \"tarball\")
@end example"
  (when (and load? (not (string=? format "docker")))
    (raise-maak-error
     (simple-format #f "#:load? needs a docker bundle, not ~s" format)
     #:hint "Build with #:format \"docker\" to load it into the container engine."))
  (let* ((script (bundle-script #:name name
                                #:maak-file maak-file
                                #:maak-package maak-package
                                #:packages packages
                                #:home-page home-page
                                #:description description))
         (path (bundle-script-path))
         (target (or output
                     (string-append (getcwd) "/"
                                    (bundle-file-name name format))))
         (keep? #f))
    (write-file path script)
    (dynamic-wind
      (lambda () #f)
      (lambda ()
        (catch #t
          (lambda ()
            (guix-pack '()
                       #:file path
                       #:format format
                       #:output target
                       #:symlinks '("/bin=bin")
                       #:relocatable? (string=? format "tarball")
                       #:verbose? verbose?)
            (when load?
              (container (list "load" "-i" target)))
            target)
          (lambda (key . vals)
            (set! keep? #t)
            (let ((error (find-maak-error key vals)))
              (if error
                  (raise-maak-error
                   (maak-error-message error)
                   #:hint
                   (simple-format #f
                                  "The package maak generated is kept in ~a; run `guix pack --file=~a -S /bin=bin' by hand to read Guix's own message."
                                  path path))
                  (apply throw key vals))))))
      (lambda ()
        (unless keep?
          (when (file-exists? path)
            (delete-file path)))))))
