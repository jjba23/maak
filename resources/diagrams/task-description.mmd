---
config:
  theme: base
  look: neo
  fontFamily: "Inter, Segoe UI, Helvetica, Arial, sans-serif"
  themeVariables:
    primaryColor: "#eef2ff"
    primaryTextColor: "#1e1b4b"
    primaryBorderColor: "#a5b4fc"
    lineColor: "#94a3b8"
    textColor: "#1e1b4b"
    edgeLabelBackground: "#eef2ff"
    clusterBkg: "#f8fafc"
    clusterBorder: "#cbd5e1"
  flowchart:
    curve: basis
    nodeSpacing: 34
    rankSpacing: 46
    padding: 12
---
flowchart LR
  file["maak.scm"]

  subgraph reading["read, never evaluated"]
    forms["read-forms"]
    defs["a define, define*<br/>or a lambda"]
    exports{"in #:export?"}
    metadata["metadata-plist"]
  end

  subgraph description["the task description"]
    task["static-tasks<br/>name, docstring,<br/>arguments, hidden"]
  end

  subgraph views["built from it"]
    listing["maak --list"]
    plan["maak --dry-run"]
    callgraph["static-call-graph"]
  end

  file --> forms --> defs --> exports
  exports -- "named" --> task
  exports -- "not named" --> helper["a helper,<br/>not a task"]
  exports -- "no list" --> task
  file --> metadata --> task
  task --> listing
  task --> plan
  task --> callgraph
