#compdef maak
#
# zsh completion for maak.
#
# Generated by `maak --completion zsh'.  Edit src/maak/completion.scm and run
# `maak completions'; this file is a copy of what that task writes.

_maak() {
    # `_arguments' rewrites `words' while an action runs, so the line as it was
    # typed is kept here for the task action below to read.
    local -a maak_line=("${words[@]}")
    local maak_position=${CURRENT}
    _arguments -s -S \
        '(-f --file)--file[Specify the path to the Maak file]:Maak file:_files' \
        '(-f --file)-f[Specify the path to the Maak file]' \
        '(-C --directory)--directory[Change to a directory before reading the Maak file]:directory:_directories' \
        '(-C --directory)-C[Change to a directory before reading the Maak file]' \
        '(-e --env-file)--env-file[Read NAME=VALUE assignments from a file]:Maak file:_files' \
        '(-e --env-file)-e[Read NAME=VALUE assignments from a file]' \
        '--no-env-file[Read no environment file at all]' \
        '--banner[Print the greeting banner]' \
        '--no-banner[Skip the greeting banner]' \
        '(-h --help)--help[Display the help screen and exit]' \
        '(-h --help)-h[Display the help screen and exit]' \
        '(-i --ignore-errors)--ignore-errors[Keep going after a failure, and still succeed]' \
        '(-i --ignore-errors)-i[Keep going after a failure, and still succeed]' \
        '(-j --jobs)--jobs[Run up to this many tasks at the same time]:N:' \
        '(-j --jobs)-j[Run up to this many tasks at the same time]' \
        '(-k --keep-going)--keep-going[Keep going after a failure]' \
        '(-k --keep-going)-k[Keep going after a failure]' \
        '(-l --list)--list=-[List the tasks of the Maak file]:layout:(table plain long names json completion)' \
        '(-l --list)-l[List the tasks of the Maak file]' \
        '--list-width[Fold a listing to this many columns]:N:' \
        '--json[Print the listing or the plan as JSON]' \
        '--plan[Print the plan a run would execute, without running it]' \
        '--watch[Re-run the named tasks whenever the tree changes]' \
        '--explain[Explain a task, what it calls and which environment file wins]' \
        '--completion[Print the completion script for a shell]:shell:(bash zsh fish)' \
        '(-t --tasks)--tasks[Run the tasks named in a comma separated list]:task:_maak_tasks' \
        '(-t --tasks)-t[Run the tasks named in a comma separated list]' \
        '(-L --load-path)--load-path[Add a directory to the Guile load path]:directory:_directories' \
        '(-L --load-path)-L[Add a directory to the Guile load path]' \
        '(-n --dry-run)--dry-run[Print the commands a run would execute, without running them]' \
        '(-n --dry-run)-n[Print the commands a run would execute, without running them]' \
        '--no-print-directory[Do not report the directories -C enters]' \
        '(-q --quiet)--quiet[Suppress logging output]' \
        '(-q --quiet)-q[Suppress logging output]' \
        '(-v --version)--version[Print the version and exit]' \
        '(-v --version)-v[Print the version and exit]' \
        '--debug[Print the Guile backtrace on an error]' \
        '*:task:_maak_tasks'
}

# The tasks of the Maak file the line is about, as `name:summary' words.
#
# maak answers this rather than this script reading the file, so a task a
# macro defines or a used module brings in is offered like any other, and the
# -f/--file and -C/--directory given before the cursor decide which file is
# read.  `_sequence' walks a comma separated task list one word at a time.
_maak_tasks() {
    local -a entries
    local -a selection
    local i
    for ((i = 2; i < maak_position; i++)); do
        case "${maak_line[i]}" in
            -f|--file|-C|--directory)
                if (( i + 1 < maak_position )); then
                    selection+=("${maak_line[i]}" "${maak_line[i + 1]}")
                    (( i++ ))
                fi
                ;;
        esac
    done
    entries=(${(f)"$(maak --list=completion ${selection[@]} 2>/dev/null)"})
    # `_describe' reads a candidate and its description apart on a colon.
    entries=("${(@)entries//$'\t'/:}")
    (( ${#entries} )) || return 1
    _sequence -s , _describe -t maak-tasks 'maak task' entries
}

# Autoloaded from fpath, zsh calls `_maak' itself; sourced by hand, the
# binding is made here.
if [[ "${funcstack[1]}" == "_maak" ]]; then
    _maak "$@"
else
    compdef _maak maak 2>/dev/null || true
fi
