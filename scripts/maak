# Commentary:
#
# This bash script provides a convenient and user-friendly wrapper
# around the command-line usage of `maak`, allowing the
# Guile Scheme application to behave and feel like any other
# executable or binary that users may install to their systems.
#
# This also helps installing `maak` in a convenient fashion
# to the Guix store and it allows us to decouple the user-facing
# command-line interface from the internal Guile Scheme arguments
# to the main program and library.
#
# Some of the rationale behind the `SCRIPT_DIR` and `STORE_DIR`
# can be explained due to the need of reliably and reproducibly
# deploying source code and other resources to the store
# and have access to those at runtime.
#
# NOTE: the option grammar here mirrors `maak-option-spec' in
# `(maak main)'.  Keep the two in step so a mistyped flag is caught
# before Guile starts.

set -euo pipefail

script_dir=$(dirname "$0")
store_dir=$(readlink -f "$script_dir/..")
scheme_sources_dir="$store_dir/share/guile/site/3.0"
resources_dir="$store_dir/share/resources"
scripts_dir="$store_dir/share/scripts"

bold_text='\033[1m'
red_text='\033[0;31m'
reset_text='\033[0m'

get_timestamp() {
  date '+%Y-%m-%d %H:%M:%S%:z'
}

log_error() {
  if [ -z "${1:-}" ]; then
    log_error "log-error was called without a message."
    return 1
  fi

  echo -e "${red_text}[ERROR][$(get_timestamp)] ${1}${reset_text}" >&2
}

log_info() {
  if [ -z "${1:-}" ]; then
    log_error "log-info was called without a message."
    return 1
  fi

  echo -e "${bold_text}[INFO][$(get_timestamp)] ${1}${reset_text}"
}


show_help() {
  cat "$resources_dir/help.txt"
}

parsed_options=$(getopt -n "maak" -o e:lf:hL:nqv --longoptions list,file:,help,dry-run,quiet,load-path:,env-file:,no-env-file,banner,no-banner,version,debug -- "$@")
eval set -- "$parsed_options"

file_arg=""
# Repeated -L flags are collected and handed to Guile as one colon separated
# list, the same shape as PATH and GUILE_LOAD_PATH.
load_paths=()
# Repeated -e flags are collected the same way.
env_files=()

guile_cmd_args=(
  "-L" "${scheme_sources_dir}"
  "-c" "(exit ((@(maak main) main)))"
  "--resources" "${resources_dir}"
)

while true; do
  case "${1}" in
  -f | --file)
    if [ -z "${2:-}" ]; then
      log_error "The --file option needs a path."
      exit 1
    fi
    file_arg="${2}"
    if [ ! -f "${file_arg}" ]; then
      log_error "No such Maak file: '${file_arg}'"
      exit 1
    fi
    guile_cmd_args+=("--file" "$(realpath "${file_arg}")")
    shift 2
    ;;
  -h | --help)
    show_help
    exit 0
    ;;
  -l | --list)
    guile_cmd_args+=("--list")
    shift
    ;;
  -L | --load-path)
    if [ -z "${2:-}" ]; then
      log_error "The --load-path option needs a directory."
      exit 1
    fi
    load_paths+=("${2}")
    shift 2
    ;;
  -n | --dry-run)
    guile_cmd_args+=("--dry-run")
    shift
    ;;
  -q | --quiet)
    guile_cmd_args+=("--quiet")
    shift
    ;;
  -e | --env-file)
    if [ -z "${2:-}" ]; then
      log_error "The --env-file option needs a path."
      exit 1
    fi
    env_files+=("${2}")
    shift 2
    ;;
  --no-env-file)
    guile_cmd_args+=("--no-env-file")
    shift
    ;;
  --banner)
    guile_cmd_args+=("--banner")
    shift
    ;;
  --no-banner)
    guile_cmd_args+=("--no-banner")
    shift
    ;;
  -v | --version)
    guile_cmd_args+=("--version")
    shift
    ;;
  --debug)
    guile_cmd_args+=("--debug")
    shift
    ;;
  --)
    shift
    [ "$#" -gt 0 ] && guile_cmd_args+=("--tasks" "${@}")
    break
    ;;
  *)
    log_error "unrecognized option '${1}'"
    show_help
    exit 1
    ;;
  esac
done

if [ "${#load_paths[@]}" -gt 0 ]; then
  joined_load_paths=$(IFS=:; echo "${load_paths[*]}")
  guile_cmd_args+=("--load-path" "${joined_load_paths}")
fi

if [ "${#env_files[@]}" -gt 0 ]; then
  joined_env_files=$(IFS=:; echo "${env_files[*]}")
  guile_cmd_args+=("--env-file" "${joined_env_files}")
fi

if [[ -z "${file_arg}" ]]; then
  # Default to the maak file in the current directory.  An absolute path keeps
  # Guile from resolving it against its own module directory.
  if [ ! -f ./maak.scm ]; then
    log_error "No Maak file found: './maak.scm'"
    log_info "Create one, or name another with -f/--file. Run 'maak --help' for the options."
    exit 1
  fi
  guile_cmd_args+=("--file" "$(realpath ./maak.scm)")
fi

# Run Guile application
exec guile "${guile_cmd_args[@]}"
