# fish completion for maak.
#
# Generated by `maak --completion fish'.  Edit src/maak/completion.scm and run
# `maak completions'; this file is a copy of what that task writes.

# Start from nothing, and offer no file name where maak expects a task.
complete -c maak -e
complete -c maak -f

complete -c maak -s f -l file -r -F -d "Specify the path to the Maak file"
complete -c maak -s C -l directory -r -a "(__fish_complete_directories)" -d "Change to a directory before reading the Maak file"
complete -c maak -s e -l env-file -r -F -d "Read NAME=VALUE assignments from a file"
complete -c maak -l no-env-file -d "Read no environment file at all"
complete -c maak -l banner -d "Print the greeting banner"
complete -c maak -l no-banner -d "Skip the greeting banner"
complete -c maak -s h -l help -d "Display the help screen and exit"
complete -c maak -s i -l ignore-errors -d "Keep going after a failure, and still succeed"
complete -c maak -s j -l jobs -x -d "Run up to this many tasks at the same time"
complete -c maak -s k -l keep-going -d "Keep going after a failure"
complete -c maak -s l -l list -f -d "List the tasks of the Maak file"
complete -c maak -s l -l list -x -a "table plain long names json completion" -n "string match -q -- '--list=*' (commandline -ct)" -d "Lay the listing out this way"
complete -c maak -l list-width -x -d "Fold a listing to this many columns"
complete -c maak -l json -d "Print the listing or the plan as JSON"
complete -c maak -l plan -d "Print the plan a run would execute, without running it"
complete -c maak -l watch -d "Re-run the named tasks whenever the tree changes"
complete -c maak -l explain -d "Explain a task, what it calls and which environment file wins"
complete -c maak -l completion -x -a "bash zsh fish" -d "Print the completion script for a shell"
complete -c maak -s t -l tasks -x -a "(__fish_maak_targets)" -d "Run the tasks named in a comma separated list"
complete -c maak -s L -l load-path -r -a "(__fish_complete_directories)" -d "Add a directory to the Guile load path"
complete -c maak -s n -l dry-run -d "Print the commands a run would execute, without running them"
complete -c maak -l no-print-directory -d "Do not report the directories -C enters"
complete -c maak -s q -l quiet -d "Suppress logging output"
complete -c maak -s v -l version -d "Print the version and exit"
complete -c maak -l debug -d "Print the Guile backtrace on an error"

# The tasks of the Maak file the line is about, as candidates with the first
# line of the task's docstring beside them.
#
# maak answers this rather than this script reading the file, so a task a
# macro defines or a used module brings in is offered like any other, and the
# -f/--file and -C/--directory given before the cursor decide which file is
# read.
function __fish_maak_tasks
    set -l words (commandline -opc)
    set -l selection
    for i in (seq (count $words))
        switch $words[$i]
            case -f --file -C --directory
                if test (count $words) -gt $i
                    set -a selection $words[$i] $words[(math $i + 1)]
                end
        end
    end
    maak --list=completion $selection 2>/dev/null
end

# The same candidates, carrying on a comma separated task list, as in
# `maak fmt,quick'.
function __fish_maak_targets
    set -l token (commandline -ct)
    set -l prefix ""
    set -l stem $token
    if string match -q "*,*" -- $token
        set prefix (string replace -r '[^,]*$' '' -- $token)
        set stem (string replace -r '^.*,' '' -- $token)
    end
    for line in (__fish_maak_tasks)
        set -l name (string replace -r '\t.*$' '' -- $line)
        string match -q -- "$stem*" $name; or continue
        if test -n "$prefix"
            printf '%s%s\t%s\n' $prefix $name \
                (string replace -r '^[^\t]*\t' '' -- $line)
        else
            printf '%s\n' $line
        end
    end
end

complete -c maak -a "(__fish_maak_targets)" -d "Maak task"
