#!/usr/bin/env -S guile --no-auto-compile -s
!#
;;; maak-tasks --- print a Maak file's tasks, for editor integrations
;;
;; SPDX-License-Identifier: MIT
;; Copyright © Josep Bigorra <jjbigorra@gmail.com>
;;
;;; Commentary:
;;
;; The helper every integration under contrib/ runs.  It reads a Maak file
;; without evaluating it -- so asking for the task list runs nothing, works while
;; the file is halfway through an edit, and needs none of the modules the project
;; imports -- and prints the tasks in whichever shape the caller asks for.
;;
;; The reading is `(maak tasks)', the same module `maak --list --json' answers
;; from, so a task is described in one place in this repository rather than once
;; per integration.  What lives here is the front end: the option grammar the
;; integrations use, the modes that keep a shell integration out of JSON, and the
;; exit status it reads.
;;
;; The library is maak's, so it comes from the checkout this script sits in
;; (`<script>/../../src') or from the load path, which is where an installed maak
;; puts it.  Either way, nothing loads the Maak file itself.
;;
;; The output is JSON, because that is what an editor can consume whatever it is
;; written in:
;;
;;   {"version": 1, "file": "/p/maak.scm", "root": "/p",
;;    "tasks": [{"name": "build", "doc": "Compile.", "line": 7,
;;               "depends": [], "example": "",
;;               "arguments": [{"name": "target", "kind": "required",
;;                              "default": "", "hasDefault": false,
;;                              "keyword": "", "doc": "what to build"}]}]}
;;
;; `kind' is one of required, optional, key or rest; `default' is the default
;; expression as it is written in the file; and `doc' is the prose the
;; docstring's `Args:' section gives that argument.  A keyword argument cannot be
;; passed by maak's command line at all, so an integration shows it and never
;; asks for it.
;;
;; The other modes exist so that a shell integration never has to parse JSON:
;; `--names' prints one task per line, `--preview NAME' the description fzf
;; shows, and `--words NAME' one tab separated line per argument.
;;
;;; Code:

(use-modules (ice-9 format)
             (srfi srfi-1)
             (srfi srfi-13))

(define program-name "maak-tasks")

(define (warn fmt . args)
  (format (current-error-port) "~a: " program-name)
  (apply format (current-error-port) fmt args)
  (newline (current-error-port)))

(define (die fmt . args)
  (apply warn fmt args)
  (exit 2))

(define usage
  "Usage: maak-tasks [OPTION]...

Print the tasks of a Maak file, as JSON.

  -f, --file FILE        read FILE instead of looking for maak.scm
  -C, --directory DIR    look for maak.scm in DIR and its parents
      --names            print one task name per line, in file order
      --fzf              print name, signature and first docstring line, tab
                         separated, for a picker
      --zed              print a Zed tasks.json for the file's tasks
      --preview NAME     print the description of task NAME
      --words NAME       print NAME's arguments, one tab separated line each:
                         kind, name, default, and 1 when it has a default
  -h, --help             print this help and exit

The Maak file is found in DIR (or the current directory) and its parents.  The
file is read, not evaluated, so no task runs.  A task that asked a listing to
leave it out with `task-metadata!' is left out here too.")

;;; The library
;;
;; `(maak tasks)' is maak's own reader, and this script is a copy of nothing but
;; its front end.  A checkout is found beside the script; an installed maak is
;; found on the load path.  Neither is required to *run* a task, only to read
;; one, which is why a missing library is a message rather than a backtrace.

(let ((sources (format #f "~a/../../src" (dirname (canonicalize-path
                                                  (car (command-line)))))))
  (when (file-exists? (format #f "~a/maak/tasks.scm" sources))
    (add-to-load-path sources)))

(unless (catch #t
          (lambda () (resolve-module '(maak tasks)) #t)
          (lambda args #f))
  (die "~a needs maak's libraries: run it from a maak checkout, or put an installed maak on GUILE_LOAD_PATH"
       program-name))

(use-modules (maak tasks)
             (maak dsl))

;;; Reading the Maak file

(define (maak-file-in directory)
  "Return the path of the maak.scm in DIRECTORY or its parents, or #f."
  (let loop ((dir directory))
    (let ((candidate (in-vicinity dir "maak.scm")))
      (cond ((file-exists? candidate) candidate)
            (else
             (let ((parent (dirname dir)))
               (and (not (string=? parent dir)) (loop parent))))))))

(define (tasks-of path)
  "Return the tasks PATH describes, or leave with the reason it cannot."
  (unless (file-exists? path)
    (die "~a is not a file" path))
  (catch #t
    (lambda () (static-tasks path))
    (lambda (key . vals)
      (let ((error (find-maak-error key vals)))
        (die "~a" (if error
                     (maak-error-message error)
                     (exception->message key vals)))))))

;;; The command line

(define (option-value arguments)
  (if (null? (cdr arguments))
      (die "~a needs a value" (car arguments))
      (cadr arguments)))

(define (main arguments)
  (let loop ((arguments arguments)
             (file #f)
             (directory #f)
             (mode 'json)
             (task-name #f))
    (cond
     ((null? arguments)
      (let* ((path (cond (file file)
                         (directory
                          (let ((found (and (file-exists? directory)
                                            (maak-file-in
                                             (canonicalize-path directory)))))
                            (or found
                                (die "no maak.scm in ~a or its parents" directory))))
                         (else
                          (or (maak-file-in (getcwd))
                              (die "no maak.scm in ~a or its parents" (getcwd))))))
             (tasks (tasks-of path)))
        (case mode
          ((json) (display (tasks-json tasks path)) (newline))
          ((names) (display (task-names-text tasks)))
          ((fzf) (display (tasks-fzf-text tasks)))
          ((zed) (display (zed-tasks-json tasks)) (newline))
          ((preview words)
           (let ((task (find (lambda (described)
                               (string=? (task-description-name described)
                                         task-name))
                             tasks)))
             (unless task (die "~a defines no task called ~a" path task-name))
             (display (if (eq? mode 'preview)
                          (task-preview-text task)
                          (task-words-text task))))))))
     ((member (car arguments) '("-h" "--help"))
      (display usage) (newline) (exit 0))
     ((member (car arguments) '("-f" "--file"))
      (loop (cddr arguments) (option-value arguments) directory mode task-name))
     ((member (car arguments) '("-C" "--directory"))
      (loop (cddr arguments) file (option-value arguments) mode task-name))
     ((string=? (car arguments) "--names")
      (loop (cdr arguments) file directory 'names task-name))
     ((string=? (car arguments) "--fzf")
      (loop (cdr arguments) file directory 'fzf task-name))
     ((string=? (car arguments) "--zed")
      (loop (cdr arguments) file directory 'zed task-name))
     ((string=? (car arguments) "--preview")
      (loop (cddr arguments) file directory 'preview (option-value arguments)))
     ((string=? (car arguments) "--words")
      (loop (cddr arguments) file directory 'words (option-value arguments)))
     ((string-prefix? "--file=" (car arguments))
      (loop (cdr arguments) (substring (car arguments) 7) directory mode task-name))
     ((string-prefix? "--directory=" (car arguments))
      (loop (cdr arguments) file (substring (car arguments) 12) mode task-name))
     (else (die "unknown option ~a (see --help)" (car arguments))))))

(main (cdr (command-line)))
