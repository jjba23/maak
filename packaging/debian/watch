# The release archive is the tag GitHub publishes, which is the one
# packaging/arch/PKGBUILD, packaging/voidlinux/template and the Homebrew formula
# fetch as well.  `uscan --download-current-version' fetches the version the
# package is at; uscan's own filename convention puts it in the tarball
# dpkg-source expects.

version=4
opts=filenamemangle=s%^.*?/v?(\d\S+)\.tar\.gz$%maak-$1.tar.gz% \
   https://github.com/jjba23/maak/tags \
   .*/v?(\d\S+)\.tar\.gz
